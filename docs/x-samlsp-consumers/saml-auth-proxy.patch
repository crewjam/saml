diff --git a/server/auth.go b/server/auth.go
new file mode 100644
index 0000000..fe0966e
--- /dev/null
+++ b/server/auth.go
@@ -0,0 +1,135 @@
+package server
+
+import (
+	"crypto/rand"
+	"errors"
+	"net/http"
+
+	"github.com/crewjam/saml/x/samlsp"
+	"github.com/crewjam/saml/x/samlsp/pending"
+	"go.uber.org/zap"
+)
+
+// authenticator does what samlsp.Middleware and its CookieSessionProvider
+// did: x/samlsp handles only the SAML messages, and the session cookie is
+// ours. The pending tracker replaces CookieRequestTracker.
+type authenticator struct {
+	sp           *samlsp.Config
+	pending      *pending.Tracker
+	cfg          *Config
+	logger       *zap.Logger
+	codec        SessionCodec
+	cookieDomain string
+	secure       bool
+}
+
+// session returns the session of the request's cookie.
+func (a *authenticator) session(r *http.Request) (*Session, error) {
+	c, err := r.Cookie(a.cfg.CookieName)
+	if err != nil {
+		return nil, err
+	}
+	s := &Session{}
+	if err := a.codec.Decode(c.Value, s); err != nil {
+		return nil, err
+	}
+	return s, nil
+}
+
+// require replaces RequireAccount, preHandleNonInteractive and
+// InitAnonymousSessionProvider: it puts the session in the request context,
+// or starts a login.
+func (a *authenticator) require(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		s, err := a.session(r)
+		switch {
+		case err == nil:
+		case a.cfg.InitiateSessionPath != "" && r.URL.Path != a.cfg.InitiateSessionPath:
+			a.logger.Debug("Auth has not been initiated, using anonymous session", zap.String("path", r.URL.Path))
+			s = anonymousSession
+		case isNonInteractiveRequest(r):
+			a.logger.Debug("Fail-fast non-interactive request without auth session", zap.String("path", r.URL.Path))
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		default:
+			a.startLogin(w, r)
+			return
+		}
+		next.ServeHTTP(w, r.WithContext(withSession(r.Context(), s)))
+	})
+}
+
+// startLogin sends the browser to the IdP. It replaces HandleStartAuthFlow.
+func (a *authenticator) startLogin(w http.ResponseWriter, r *http.Request) {
+	relayState := rand.Text()
+	if a.cfg.StaticRelayState != "" {
+		relayState = a.cfg.StaticRelayState[:min(80, len(a.cfg.StaticRelayState))]
+	}
+	msg, err := a.sp.AuthnRequest(r.Context(), relayState)
+	if err != nil {
+		a.logger.Error("Failed to make AuthnRequest", zap.Error(err))
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+	// Remember the request, and where to return to, until the IdP answers.
+	if err := a.pending.Remember(w, msg, a.returnURI(r)); err != nil {
+		a.logger.Error("Failed to remember the login", zap.Error(err))
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+	msg.Write(w)
+}
+
+// returnURI is where the browser goes after login: the URL it asked for.
+func (a *authenticator) returnURI(r *http.Request) string {
+	if a.cfg.AuthVerify && r.Header.Get(HeaderForwardedProto) != "" && r.Header.Get(HeaderForwardedHost) != "" && r.Header.Get(HeaderForwardedURI) != "" {
+		return r.Header.Get(HeaderForwardedProto) + "://" + r.Header.Get(HeaderForwardedHost) + r.Header.Get(HeaderForwardedURI)
+	}
+	u := *r.URL
+	u.Host = r.Host
+	return u.String()
+}
+
+// acs verifies the IdP's Response and sets the session cookie.
+func (a *authenticator) acs(w http.ResponseWriter, r *http.Request) {
+	var opts []samlsp.ResponseOption
+	returnTo := "/"
+	if login, err := a.pending.Take(w, r); err == nil {
+		opts = append(opts, samlsp.WithRequestID(login.ID))
+		returnTo = login.Data
+	} else if !errors.Is(err, pending.ErrNotFound) {
+		a.logger.Warn("Invalid pending login cookie", zap.Error(err))
+	}
+	if a.cfg.AllowIdpInitiated {
+		opts = append(opts, samlsp.AllowUnsolicited)
+	}
+
+	assertion, err := a.sp.ParseResponse(r.Context(), r, opts...)
+	if err != nil {
+		a.logger.Warn("SAML Response refused", zap.Error(err))
+		if errors.Is(err, samlsp.ErrNoRequestID) {
+			http.Error(w, "No login in progress", http.StatusBadRequest)
+			return
+		}
+		http.Error(w, http.StatusText(http.StatusForbidden), http.StatusForbidden)
+		return
+	}
+
+	token, err := a.codec.Encode(newSession(assertion, a.sp.EntityID(), a.cfg.CookieMaxAge))
+	if err != nil {
+		a.logger.Error("Failed to encode session", zap.Error(err))
+		w.WriteHeader(http.StatusInternalServerError)
+		return
+	}
+	http.SetCookie(w, &http.Cookie{
+		Name:     a.cfg.CookieName,
+		Value:    token,
+		Domain:   a.cookieDomain,
+		Path:     "/",
+		MaxAge:   int(a.cfg.CookieMaxAge.Seconds()),
+		HttpOnly: true,
+		Secure:   a.secure,
+		SameSite: http.SameSiteLaxMode,
+	})
+	http.Redirect(w, r, returnTo, http.StatusFound)
+}
