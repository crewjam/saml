+package server
+
+import (
+	"context"
+	"crypto"
+	"crypto/ecdsa"
+	"crypto/rand"
+	"crypto/rsa"
+	"fmt"
+	"time"
+
+	"github.com/crewjam/saml/x/samlsp"
+	"github.com/golang-jwt/jwt/v5"
+)
+
+// Attributes are the SAML attributes of a session, keyed by FriendlyName,
+// or by Name when there is none, as samlsp.JWTSessionClaims keyed them, so
+// that AttributeHeaderMappings and AuthorizeAttribute keep matching.
+type Attributes map[string][]string
+
+// Get returns the first value of the attribute key, or "".
+func (a Attributes) Get(key string) string {
+	if v := a[key]; len(v) > 0 {
+		return v[0]
+	}
+	return ""
+}
+
+// Session is the session cookie's content. It replaces
+// samlsp.JWTSessionClaims.
+type Session struct {
+	jwt.RegisteredClaims
+	Attributes Attributes `json:"attr"`
+}
+
+// GetAttributes returns the session's attributes.
+func (s *Session) GetAttributes() Attributes { return s.Attributes }
+
+// newSession returns a session for the verified assertion, valid for maxAge.
+func newSession(assertion *samlsp.Assertion, audience string, maxAge time.Duration) *Session {
+	now := time.Now()
+	s := &Session{
+		RegisteredClaims: jwt.RegisteredClaims{
+			ID:        rand.Text(),
+			Subject:   assertion.Subject,
+			Audience:  jwt.ClaimStrings{audience},
+			IssuedAt:  jwt.NewNumericDate(now),
+			NotBefore: jwt.NewNumericDate(now),
+			ExpiresAt: jwt.NewNumericDate(now.Add(maxAge)),
+		},
+		// Keyed as samlsp.JWTSessionClaims keyed them.
+		Attributes: assertion.Attributes.LegacyMap(),
+	}
+	s.Attributes["SessionIndex"] = append(s.Attributes["SessionIndex"], assertion.SessionIndexes...)
+	return s
+}
+
+// SessionCodec turns claims into a cookie value and back. It replaces
+// samlsp.SessionCodec.
+type SessionCodec interface {
+	Encode(claims jwt.Claims) (string, error)
+	Decode(token string, claims jwt.Claims) error
+}
+
+// JWTSessionCodec signs claims as a JWT with the SP key, as
+// samlsp.JWTSessionCodec did.
+type JWTSessionCodec struct {
+	key      crypto.Signer
+	method   jwt.SigningMethod
+	audience string
+}
+
+// NewJWTSessionCodec returns a codec that signs with key, an RSA or ECDSA
+// key, and accepts only tokens for audience.
+func NewJWTSessionCodec(key crypto.Signer, audience string) (*JWTSessionCodec, error) {
+	var method jwt.SigningMethod
+	switch pub := key.Public().(type) {
+	case *rsa.PublicKey:
+		method = jwt.SigningMethodRS256
+	case *ecdsa.PublicKey:
+		switch pub.Curve.Params().BitSize {
+		case 256:
+			method = jwt.SigningMethodES256
+		case 384:
+			method = jwt.SigningMethodES384
+		case 521:
+			method = jwt.SigningMethodES512
+		}
+	}
+	if method == nil {
+		return nil, fmt.Errorf("unsupported SP key type %T for session tokens", key)
+	}
+	return &JWTSessionCodec{key: key, method: method, audience: audience}, nil
+}
+
+func (c *JWTSessionCodec) Encode(claims jwt.Claims) (string, error) {
+	return jwt.NewWithClaims(c.method, claims).SignedString(c.key)
+}
+
+func (c *JWTSessionCodec) Decode(token string, claims jwt.Claims) error {
+	_, err := jwt.ParseWithClaims(token, claims,
+		func(*jwt.Token) (any, error) { return c.key.Public(), nil },
+		jwt.WithValidMethods([]string{c.method.Alg()}),
+		jwt.WithAudience(c.audience),
+		jwt.WithExpirationRequired())
+	return err
+}
+
+type sessionKey struct{}
+
+// anonymousSession is the session of a request let through before the
+// InitiateSessionPath has been visited.
+var anonymousSession = &Session{}
+
+// IsAnonymousSession reports whether s is the anonymous session.
+func IsAnonymousSession(s *Session) bool { return s == anonymousSession }
+
+func withSession(ctx context.Context, s *Session) context.Context {
+	return context.WithValue(ctx, sessionKey{}, s)
+}
+
+// SessionFromContext returns the session that the authenticator put in
+// ctx, or nil.
+func SessionFromContext(ctx context.Context) *Session {
+	s, _ := ctx.Value(sessionKey{}).(*Session)
+	return s
+}
