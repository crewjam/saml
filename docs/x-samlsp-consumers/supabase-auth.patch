@@ -0,0 +1,11 @@
+/* auth_migration: 20261108120000 */
+-- Keys (samlsp.ReplayKey: a SHA-256 hash of the IdP's entity ID and the
+-- message ID) of the SAML messages accepted, so that each is accepted once
+-- across every instance (see models.ConsumeSAMLID).
+create table if not exists {{ index .Options "Namespace" }}.saml_consumed_ids (
+    id bytea not null primary key,
+    expires_at timestamptz not null
+);
+
+create index if not exists saml_consumed_ids_expires_at_idx
+    on {{ index .Options "Namespace" }}.saml_consumed_ids (expires_at);
