diff --git a/internal/models/saml_consumed_id.go b/internal/models/saml_consumed_id.go
new file mode 100644
index 0000000..fcb871b
--- /dev/null
+++ b/internal/models/saml_consumed_id.go
@@ -0,0 +1,38 @@
+package models
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/crewjam/saml"
+	"github.com/supabase/auth/internal/storage"
+)
+
+// SAMLConsumedID is the replay key of a SAML message that has been
+// accepted, kept until the message could no longer be accepted anyway.
+type SAMLConsumedID struct {
+	ID        []byte    `db:"id"`
+	ExpiresAt time.Time `db:"expires_at"`
+}
+
+func (SAMLConsumedID) TableName() string {
+	return "saml_consumed_ids"
+}
+
+// ConsumeSAMLID records the message with replay key id as accepted until
+// expiresAt. It returns saml.ErrAssertionReplayed if id is already recorded
+// and not expired.
+func ConsumeSAMLID(tx *storage.Connection, id []byte, expiresAt time.Time) error {
+	table := SAMLConsumedID{}.TableName()
+	n, err := tx.RawQuery(fmt.Sprintf(`
+		insert into %q (id, expires_at) values (?, ?)
+		on conflict (id) do update set expires_at = excluded.expires_at
+		where %q.expires_at < now()`, table, table), id, expiresAt).ExecWithCount()
+	if err != nil {
+		return err
+	}
+	if n == 0 {
+		return saml.ErrAssertionReplayed
+	}
+	return nil
+}
