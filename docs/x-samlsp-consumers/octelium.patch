+func decodeAuthnRequest(t *testing.T, loginURL string) (*saml.AuthnRequest, url.Values) {
+	u, err := url.Parse(loginURL)
+	assert.Nil(t, err)
+
+	deflated, err := base64.StdEncoding.DecodeString(u.Query().Get("SAMLRequest"))
+	assert.Nil(t, err)
+
+	reqXML, err := io.ReadAll(flate.NewReader(bytes.NewReader(deflated)))
+	assert.Nil(t, err)
+
+	var req saml.AuthnRequest
+	assert.Nil(t, xml.Unmarshal(reqXML, &req))
+	return &req, u.Query()
+}
