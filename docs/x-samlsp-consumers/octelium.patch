+func TestGetLogin(t *testing.T) {
+
+	metadata := newTestIDPMetadata(t)
+
+	for _, forceAuthn := range []bool{false, true} {
+		idp := newSAMLIDP(metadata, "", "")
+		idp.Spec.GetSaml().ForceAuthn = forceAuthn
+		c := newTestConnector(t, idp)
+
+		state := utilrand.GetRandomStringCanonical(36)
+		resp, err := c.GetLogin(httptest.NewRequest("GET", "/", nil), state)
+		assert.Nil(t, err)
+		assert.NotEmpty(t, resp.ReqID)
+
+		assert.True(t, strings.HasPrefix(resp.LoginURL, "https://idp.example.com/sso?"), resp.LoginURL)
+
+		req, query := decodeAuthnRequest(t, resp.LoginURL)
+		assert.Equal(t, state, query.Get("RelayState"))
+		assert.Equal(t, resp.ReqID, req.ID)
+		assert.Equal(t, "https://idp.example.com/sso", req.Destination)
+		assert.Equal(t, "https://example.com", req.Issuer.Value)
+		assert.Equal(t, "https://example.com/callback", req.AssertionConsumerServiceURL)
+		assert.Equal(t, saml.HTTPPostBinding, req.ProtocolBinding)
+		if forceAuthn {
+			assert.NotNil(t, req.ForceAuthn)
+			assert.True(t, *req.ForceAuthn)
+		} else {
+			assert.True(t, req.ForceAuthn == nil || !*req.ForceAuthn)
+		}
+	}
+}
