+const sessionCookie = "token"
+
+// serviceProvider logs users in with SAML and keeps their sessions in memory.
+type serviceProvider struct {
+	config  *samlsp.Config
+	tracker *pending.Tracker
+
+	mu       sync.Mutex
+	sessions map[string]string // session ID -> UserName attribute
+}
+
+func (s *serviceProvider) hello(w http.ResponseWriter, r *http.Request) {
+	userName, ok := s.session(r)
+	if !ok {
+		s.login(w, r)
+		return
+	}
+	fmt.Fprintf(w, "Hello, %s!", userName)
+}
+
+func (s *serviceProvider) session(r *http.Request) (string, bool) {
+	cookie, err := r.Cookie(sessionCookie)
+	if err != nil {
+		return "", false
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	userName, ok := s.sessions[cookie.Value]
+	return userName, ok
+}
+
+// login sends the user to the IdP, and back to the requested page after the login.
+func (s *serviceProvider) login(w http.ResponseWriter, r *http.Request) {
+	msg, err := s.config.AuthnRequest(r.Context(), rand.Text())
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	// The URL is the requester's to make long: keep it within the
+	// cookie's share of the Cookie header (pending.WithMaxCookiesSize).
+	returnTo := r.URL.RequestURI()
+	if len(returnTo) > 100 {
+		returnTo = "/"
+	}
+	if err := s.tracker.Remember(w, msg, returnTo); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	msg.Write(w)
+}
+
+func (s *serviceProvider) acs(w http.ResponseWriter, r *http.Request) {
+	login, err := s.tracker.Find(w, r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusForbidden)
+		return
+	}
+	assertion, err := s.config.ParseResponse(r.Context(), r, samlsp.WithRequestID(login.ID))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusForbidden)
+		return
+	}
+	s.tracker.Forget(w, login)
+	sessionID := rand.Text()
+	s.mu.Lock()
+	s.sessions[sessionID] = assertion.Attributes.Get("UserName")
+	s.mu.Unlock()
+	http.SetCookie(w, &http.Cookie{
+		Name:     sessionCookie,
+		Value:    sessionID,
+		Path:     "/",
+		HttpOnly: true,
+		Secure:   r.TLS != nil,
+		SameSite: http.SameSiteLaxMode,
+	})
+	redirect, _ := samlsp.SafeRedirectPath(login.Data)
+	http.Redirect(w, r, redirect, http.StatusFound)
 }
 
