+// Saml2Acs verifies the IdP's answer to the AuthnRequest of Saml2Auth and
+// starts the KubePi session.
 func (h *Handler) Saml2Acs() iris.Handler {
 	return func(ctx *context.Context) {
-		saml2Config.ServeACS(ctx.ResponseWriter(), ctx.Request())
+		sp := loadSaml2(ctx)
+		if sp == nil {
+			return
+		}
+		r := ctx.Request()
+		// IdP-initiated logins were not allowed, so the Response must
+		// answer a login started in this browser.
+		login, err := sp.pending.Find(ctx.ResponseWriter(), r)
+		if err != nil {
+			server.Logger().Errorf("SAML2 login failed: %s", err)
+			ctx.StatusCode(iris.StatusForbidden)
+			ctx.Values().Set("message", "SAML2 login failed")
+			return
+		}
+		assertion, err := sp.config.ParseResponse(r.Context(), r, samlsp.WithRequestID(login.ID))
+		if err != nil {
+			server.Logger().Errorf("SAML2 login failed: %s", err)
+			ctx.StatusCode(iris.StatusForbidden)
+			ctx.Values().Set("message", "SAML2 login failed")
+			return
+		}
+		sp.pending.Forget(ctx.ResponseWriter(), login)
+
+		language := ctx.GetHeader("Accept-Language")
+		if strings.Contains(language, "zh-CN") {
+			language = "zh-CN"
+		} else {
+			language = "en-US"
+		}
+
+		// samlsp.Middleware keyed attributes by FriendlyName, or by Name
+		// when there was none. IdPs often send "givenName" and "email" as
+		// FriendlyNames, so LegacyGet keeps them matching.
+		givenName := assertion.Attributes.LegacyGet("givenName") //nolint:staticcheck // see above
+		email := assertion.Attributes.LegacyGet("email")         //nolint:staticcheck // see above
+		userProfile, err := h.ssoService.Saml2(givenName, email, language, common.DBOptions{})
+		if err != nil {
+			ctx.StatusCode(iris.StatusInternalServerError)
+			ctx.Values().Set("message", err.Error())
+			return
+		}
+		// 默认为Session
+		sId := ctx.GetCookie(server.SessionCookieName)
+		if sId != "" {
+			ctx.RemoveCookie(server.SessionCookieName)
+			ctx.Request().Header.Del("Cookie")
+		}
+		sess := server.SessionMgr.Start(ctx)
+		ctx.SetCookieKV(server.SessionCookieName, sess.ID())
+		sess.Set("profile", userProfile)
+
+		redirectURL := ""
+		if strings.HasPrefix(strings.ToLower(r.Proto), "https") {
+			redirectURL = "https://" + r.Host
+		} else if strings.HasPrefix(strings.ToLower(r.Proto), "http") {
+			redirectURL = "http://" + r.Host
+		}
+		ctx.Redirect(redirectURL, iris.StatusFound)
+		handler := v1Session.NewHandler()
+		go handler.SaveLoginLog(ctx, userProfile.Name)
 	}
 }
 
+// Saml2Slo sends the browser home. KubePi keeps no SAML session of its own
