index 0000000..5ff7375
--- /dev/null
+++ b/internal/service/v1/sso/sso_test.go
@@ -0,0 +1,124 @@
+package sso
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	v1Sso "github.com/1Panel-dev/KubePi/internal/model/v1/sso"
+	"github.com/crewjam/saml"
+	"github.com/crewjam/saml/x/samlsp"
+)
+
+func testSaml2Sso(t *testing.T) *v1Sso.Sso {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tmpl := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: "kubepi"},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &v1Sso.Sso{
+		Protocol:       "saml2",
+		IdpMetadataURL: "https://idp.example.com/metadata",
+		X509Cert:       string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})),
+		X509Key:        string(pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(key)})),
+	}
+}
+
+var testIdPMetadata = samlsp.StaticMetadata(&saml.EntityDescriptor{
+	EntityID: "https://idp.example.com/metadata",
+	IDPSSODescriptors: []saml.IDPSSODescriptor{{
+		SSODescriptor: saml.SSODescriptor{RoleDescriptor: saml.RoleDescriptor{
+			ProtocolSupportEnumeration: "urn:oasis:names:tc:SAML:2.0:protocol",
+		}},
+		SingleSignOnServices: []saml.Endpoint{{
+			Binding:  saml.HTTPRedirectBinding,
+			Location: "https://idp.example.com/sso",
+		}},
+	}},
+})
+
+// The entity ID and ACS URL are those samlsp.Middleware derived from the
+// base URL, so the registration at the IdP does not change.
+func TestSaml2ConfigURLs(t *testing.T) {
+	s := &service{}
+	config, _, err := s.newSaml2Config(testSaml2Sso(t), "https://host/kubepi/api/v1/sso/", testIdPMetadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := config.EntityID(), "https://host/kubepi/api/v1/sso/saml/metadata"; got != want {
+		t.Errorf("entity ID = %q, want %q", got, want)
+	}
+	if got, want := config.ACSURL(), "https://host/kubepi/api/v1/sso/saml/acs"; got != want {
+		t.Errorf("ACS URL = %q, want %q", got, want)
+	}
+}
+
+// The SP certificate is published for encryption, as before, so the IdP can
+// keep encrypting assertions; AuthnRequests stay unsigned.
+func TestSaml2ConfigMetadata(t *testing.T) {
+	s := &service{}
+	config, _, err := s.newSaml2Config(testSaml2Sso(t), "https://host/kubepi/api/v1/sso/", testIdPMetadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	md := config.Metadata(context.Background())
+	sp := md.SPSSODescriptors[0]
+	uses := map[string]bool{}
+	for _, kd := range sp.KeyDescriptors {
+		uses[kd.Use] = true
+	}
+	if !uses["encryption"] {
+		t.Errorf("metadata has no encryption key: %+v", sp.KeyDescriptors)
+	}
+	if sp.AuthnRequestsSigned == nil || *sp.AuthnRequestsSigned {
+		t.Errorf("AuthnRequestsSigned = %v, want false", sp.AuthnRequestsSigned)
+	}
+}
+
+// Starting a login sends the browser to the IdP and remembers the request
+// in a cookie that reaches the ACS with the IdP's cross-site POST.
+func TestSaml2PendingLogin(t *testing.T) {
+	s := &service{}
+	config, tracker, err := s.newSaml2Config(testSaml2Sso(t), "https://host/kubepi/api/v1/sso/", testIdPMetadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	msg, err := config.AuthnRequest(context.Background(), "relay")
+	if err != nil {
+		t.Fatal(err)
+	}
+	w := httptest.NewRecorder()
+	if err := tracker.Remember(w, msg, ""); err != nil {
+		t.Fatal(err)
+	}
+	msg.Write(w)
+	if w.Code != http.StatusFound {
+		t.Fatalf("status = %d, want %d", w.Code, http.StatusFound)
+	}
+	cookies := w.Result().Cookies()
+	if len(cookies) != 1 {
+		t.Fatalf("cookies = %v, want one", cookies)
+	}
+	c := cookies[0]
+	if c.Path != "/kubepi/api/v1/sso/saml/acs" || c.SameSite != http.SameSiteNoneMode || !c.Secure {
+		t.Errorf("cookie = %+v, want Path=/kubepi/api/v1/sso/saml/acs, SameSite=None, Secure", c)
+	}
+}
