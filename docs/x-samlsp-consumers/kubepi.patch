+// loadSaml2 returns the SAML service provider that LoginSso set up, or nil,
+// having answered the request, if no SAML login was started since KubePi
+// started.
+func loadSaml2(ctx *context.Context) *saml2SP {
+	sp := saml2Config.Load()
+	if sp == nil {
+		ctx.StatusCode(iris.StatusNotFound)
+		ctx.Values().Set("message", "SAML2 SSO login has not been started")
+	}
+	return sp
+}
