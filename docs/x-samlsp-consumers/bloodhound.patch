+// NewSAMLConfig returns the service provider that BloodHound presents to
+// the IdP of ssoProvider. It is cheap to build per request. replayState
+// records the IDs of the assertions it accepts, so that each is accepted
+// once; it must be shared by every BloodHound instance.
+//
+// It signs with RSA-SHA256 and refuses what the library's hardening
+// refuses, such as SHA-1 signatures and expired IdP metadata.
+func NewSAMLConfig(hostUrl url.URL, cfg config.Configuration, replayState saml.AssertionReplayCache, ssoProvider model.SSOProvider) (*samlsp.Config, error) {
+	if ssoProvider.SAMLProvider == nil {
+		return nil, fmt.Errorf("SSO provider %s is not a SAML provider", ssoProvider.Name)
+	}
+	samlProvider := *ssoProvider.SAMLProvider
+	spCert, spKey, err := crypto.X509ParsePair(cfg.SAML.ServiceProviderCertificate, cfg.SAML.ServiceProviderKey)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse service provider %s's cert pair: %w", samlProvider.Name, err)
 	}
+	samlProvider.FormatSAMLProviderURLs(hostUrl)
+
+	return samlsp.New(
+		samlsp.StaticMetadataBytes(samlProvider.MetadataXML),
+		samlProvider.ServiceProviderIssuerURI.String(),
+		samlsp.WithACSURL(samlProvider.ServiceProviderACSURI.String()),
+		samlsp.WithKey(spKey, spCert),
+		samlsp.WithNameIDFormat(saml.EmailAddressNameIDFormat),
+		samlsp.WithReplayState(replayState),
+	)
 }
