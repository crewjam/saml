+// samlConfig returns the SAML service provider for ssoProvider.
+func (s ManagementResource) samlConfig(request *http.Request, ssoProvider model.SSOProvider) (*samlsp.Config, error) {
+	var issuer string
+	if ssoProvider.SAMLProvider != nil {
+		issuer = ssoProvider.SAMLProvider.IssuerURI
+	}
+	replayState := consumedAssertions{ctx: request.Context(), db: s.db, ssoProviderID: ssoProvider.ID, issuer: issuer}
+	return auth.NewSAMLConfig(*bhctx.Get(request.Context()).Host, s.config, replayState, ssoProvider)
+}
+
+// consumedAssertions records the IDs of verified assertions in the
+// saml_consumed_identifiers table, so that each is accepted once.
+type consumedAssertions struct {
+	ctx           context.Context
+	db            database.SAMLConsumedData
+	ssoProviderID int32
+	issuer        string
+}
+
+func (c consumedAssertions) Consume(assertionID string, expiresAt time.Time) error {
+	err := c.db.ConsumeSAMLAssertionID(c.ctx, c.ssoProviderID, c.issuer, assertionID, expiresAt)
+	if errors.Is(err, database.ErrSAMLIdentifierAlreadyConsumed) {
+		return saml.ErrAssertionReplayed
+	}
+	return err
+}
