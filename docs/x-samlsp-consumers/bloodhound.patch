+// samlPending returns the tracker of the logins in progress with
+// samlConfig.
+func (s ManagementResource) samlPending(samlConfig *samlsp.Config) (*pending.Tracker, error) {
+	signingKey, err := s.config.Crypto.JWT.SigningKeyBytes()
+	if err != nil {
+		return nil, fmt.Errorf("invalid JWT signing key: %w", err)
+	}
+	mac := hmac.New(sha256.New, signingKey)
+	mac.Write([]byte(samlPendingLabel))
+	return pending.New(samlConfig, mac.Sum(nil))
+}
+
+// samlResponseOptions accepts the response to the request that this
+// browser started, if any, and an IdP-initiated response.
+func (s ManagementResource) samlResponseOptions(response http.ResponseWriter, request *http.Request, samlConfig *samlsp.Config) []samlsp.ResponseOption {
+	opts := []samlsp.ResponseOption{samlsp.AllowUnsolicited}
+	tracker, err := s.samlPending(samlConfig)
+	if err != nil {
+		slog.WarnContext(request.Context(), "[SAML] Pending login tracker creation failed", attr.Error(err))
+		return opts
+	}
+	if login, err := tracker.Take(response, request); err == nil {
+		opts = append(opts, samlsp.WithRequestID(login.ID))
+	} else if !errors.Is(err, pending.ErrNotFound) {
+		slog.WarnContext(request.Context(), "[SAML] Invalid pending login cookie", attr.Error(err))
+	}
+	return opts
+}
+
