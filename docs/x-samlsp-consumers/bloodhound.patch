+// ConsumeSAMLAssertionID records an assertion that the SAML library has
+// verified, under assertionID, so that it cannot be replayed: the library
+// passes the assertion's replay key, a hash of the IdP and the assertion's
+// ID. It returns ErrSAMLIdentifierAlreadyConsumed if it is already
+// recorded. A replayed SAMLResponse carries the same assertion, so the
+// assertion alone is enough.
+func (s *BloodhoundDB) ConsumeSAMLAssertionID(ctx context.Context, ssoProviderID int32, idpIssuer, assertionID string, expiresAt time.Time) error {
+	result := s.db.WithContext(ctx).Exec(fmt.Sprintf(`INSERT INTO %s
+		(sso_provider_id, idp_issuer, identifier_type, identifier, expires_at)
+		VALUES (?, ?, ?, ?, ?)
+		ON CONFLICT DO NOTHING`, samlConsumedIdentifiersTableName),
+		ssoProviderID, idpIssuer, samlIdentifierTypeAssertion, assertionID, expiresAt,
+	)
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected != 1 {
+		slog.WarnContext(
+			ctx,
+			"SAML assertion already consumed (possible replay)",
+			slog.Int("sso_provider_id", int(ssoProviderID)),
+			slog.String("idp_issuer", idpIssuer),
+		)
+		return ErrSAMLIdentifierAlreadyConsumed
+	}
+	return nil
+}
