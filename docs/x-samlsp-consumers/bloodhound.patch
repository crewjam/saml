+func TestDatabase_ConsumeSAMLAssertionID(t *testing.T) {
+	const (
+		idpIssuer = "https://idp.example.com/12345678-90ab-cdef-1234-567890abcdef"
+		// a replay key as x/samlsp passes it, hex-encoded
+		replayKey = "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
+	)
+
+	tests := []struct {
+		name string
+		test func(t *testing.T, testSuite IntegrationTestSuite)
+	}{
+		{
+			name: "Success: records an assertion on first login",
+			test: func(t *testing.T, testSuite IntegrationTestSuite) {
+				ssoProviderID := registerAndGetSSOProvider(t, testSuite, "provider-consume-first")
+
+				err := testSuite.BHDatabase.ConsumeSAMLAssertionID(testSuite.Context, ssoProviderID, idpIssuer, replayKey, time.Now().Add(time.Hour))
+				require.NoError(t, err)
+			},
+		},
+		{
+			name: "Error: rejects a replayed assertion",
+			test: func(t *testing.T, testSuite IntegrationTestSuite) {
+				ssoProviderID := registerAndGetSSOProvider(t, testSuite, "provider-consume-replay")
+				expiresAt := time.Now().Add(time.Hour)
+
+				err := testSuite.BHDatabase.ConsumeSAMLAssertionID(testSuite.Context, ssoProviderID, idpIssuer, replayKey, expiresAt)
+				require.NoError(t, err)
+
+				err = testSuite.BHDatabase.ConsumeSAMLAssertionID(testSuite.Context, ssoProviderID, idpIssuer, replayKey, expiresAt)
+				assert.ErrorIs(t, err, database.ErrSAMLIdentifierAlreadyConsumed)
+			},
+		},
+		{
+			name: "Success: the same key is allowed for a different sso provider",
+			test: func(t *testing.T, testSuite IntegrationTestSuite) {
+				firstProviderID := registerAndGetSSOProvider(t, testSuite, "provider-consume-scope-first")
+				secondProviderID := registerAndGetSSOProvider(t, testSuite, "provider-consume-scope-second")
+				expiresAt := time.Now().Add(time.Hour)
+
+				err := testSuite.BHDatabase.ConsumeSAMLAssertionID(testSuite.Context, firstProviderID, idpIssuer, replayKey, expiresAt)
+				require.NoError(t, err)
+
+				err = testSuite.BHDatabase.ConsumeSAMLAssertionID(testSuite.Context, secondProviderID, idpIssuer, replayKey, expiresAt)
+				require.NoError(t, err)
+			},
+		},
+		{
+			name: "Error: rejects an assertion for a non-existent sso provider",
+			test: func(t *testing.T, testSuite IntegrationTestSuite) {
+				const nonExistentSSOProviderID = int32(999999)
+
+				err := testSuite.BHDatabase.ConsumeSAMLAssertionID(testSuite.Context, nonExistentSSOProviderID, idpIssuer, replayKey, time.Now().Add(time.Hour))
+				require.Error(t, err)
+				// assert this failed on the foreign key, not as a replay rejection
+				assert.NotErrorIs(t, err, database.ErrSAMLIdentifierAlreadyConsumed)
+			},
+		},
+	}
+
+	for _, testCase := range tests {
+		t.Run(testCase.name, func(t *testing.T) {
+			testSuite := setupIntegrationTestSuite(t)
+			defer teardownIntegrationTestSuite(t, &testSuite)
+
+			testCase.test(t, testSuite)
+		})
+	}
+}
