+// samlResponseOptions accepts the response to the request that this
+// browser started, if any, and an IdP-initiated response.
+func (s ManagementResource) samlResponseOptions(response http.ResponseWriter, request *http.Request) []samlsp.ResponseOption {
+	opts := []samlsp.ResponseOption{samlsp.AllowUnsolicited}
+	if cookie, err := request.Cookie(samlRequestCookie); err == nil {
+		if relayState, requestID, ok := strings.Cut(cookie.Value, "."); ok && relayState == request.FormValue("RelayState") {
+			opts = append(opts, samlsp.WithRequestID(requestID))
+		}
+		http.SetCookie(response, &http.Cookie{Name: samlRequestCookie, Path: cookie.Path, MaxAge: -1})
+	}
+	return opts
+}
