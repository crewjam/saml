+// TestConsumedAssertions checks how the replay record that x/samlsp
+// consults maps the database's answers: a new assertion is recorded under
+// its hex-encoded replay key, one already recorded is a replay, and any
+// other failure is ErrSAMLAssertionNotRecorded, which the callback handler
+// reports as a technical failure rather than as an invalid response.
+func TestConsumedAssertions(t *testing.T) {
+	key := []byte{0xde, 0xad, 0xbe, 0xef}
+	expiresAt := time.Now().Add(time.Minute)
+
+	for _, tc := range []struct {
+		name    string
+		dbErr   error
+		wantErr error
+	}{
+		{"recorded", nil, nil},
+		{"already consumed", database.ErrSAMLIdentifierAlreadyConsumed, saml.ErrAssertionReplayed},
+		{"database failure", errors.New("connection refused"), ErrSAMLAssertionNotRecorded},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			db := dbmocks.NewMockDatabase(ctrl)
+			ctx := context.WithValue(context.Background(), struct{ name string }{"request"}, "r1")
+			db.EXPECT().ConsumeSAMLAssertionID(ctx, int32(7), "https://idp.example/saml", "deadbeef", expiresAt).Return(tc.dbErr)
+
+			err := consumedAssertions{db: db, ssoProviderID: 7, issuer: "https://idp.example/saml"}.Consume(ctx, key, expiresAt)
+			if tc.wantErr == nil {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, tc.wantErr)
+			if tc.dbErr != nil && !errors.Is(tc.dbErr, database.ErrSAMLIdentifierAlreadyConsumed) {
+				require.ErrorIs(t, err, tc.dbErr, "the database error is kept for the log")
+			}
+		})
+	}
+}
