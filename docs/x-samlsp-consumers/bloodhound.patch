+// TestManagementResource_SAMLPendingLogin checks that a login remembers its
+// AuthnRequest in this browser (BED-5071): the callback passes the
+// request's ID to ParseResponse, which then accepts only the IdP's answer
+// to that request, and accepts an IdP-initiated response otherwise.
+func TestManagementResource_SAMLPendingLogin(t *testing.T) {
+	t.Parallel()
+
+	provider := model.SSOProvider{
+		Name: "Okta",
+		Slug: "slug",
+		Type: model.SessionAuthProviderSAML,
+		SAMLProvider: &model.SAMLProvider{
+			Name:           "okta",
+			MetadataXML:    []byte(validMetadataXML),
+			RootURIVersion: model.SAMLRootURIVersion2,
+		},
+	}
+	relayStateInput := regexp.MustCompile(`name="RelayState" value="([^"]*)"`)
+
+	for _, tc := range []struct {
+		name string
+		// callback returns the callback request, from the login's
+		// response and RelayState.
+		callback func(login *httptest.ResponseRecorder, relayState string) *http.Request
+		// wantOptions is how many ResponseOptions ParseResponse gets:
+		// AllowUnsolicited, and WithRequestID for a login in progress.
+		wantOptions int
+	}{
+		{
+			name: "the browser that started the login",
+			callback: func(login *httptest.ResponseRecorder, relayState string) *http.Request {
+				r := samlCallbackRequest(relayState)
+				for _, c := range login.Result().Cookies() {
+					r.AddCookie(c)
+				}
+				return r
+			},
+			wantOptions: 2,
+		},
+		{
+			name: "another browser",
+			callback: func(_ *httptest.ResponseRecorder, relayState string) *http.Request {
+				return samlCallbackRequest(relayState)
+			},
+			wantOptions: 1,
+		},
+		{
+			name: "the cookie of another login",
+			callback: func(login *httptest.ResponseRecorder, _ string) *http.Request {
+				r := samlCallbackRequest("another-relay-state")
+				for _, c := range login.Result().Cookies() {
+					r.AddCookie(c)
+				}
+				return r
+			},
+			wantOptions: 1,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			ctrl := gomock.NewController(t)
+			mockDatabase := mocks.NewMockDatabase(ctrl)
+			mockSAML := samlmocks.NewMockService(ctrl)
+
+			mockDatabase.EXPECT().GetSSOProviderBySlug(gomock.Any(), "slug").Return(provider, nil).Times(2)
+			mockSAML.EXPECT().AuthnRequest(gomock.Any(), gomock.Any(), gomock.Any()).DoAndReturn((&bhceSAML.Client{}).AuthnRequest)
+			gotOptions := -1
+			mockSAML.EXPECT().ParseResponse(gomock.Any(), gomock.Any(), gomock.Any(), gomock.Any()).
+				DoAndReturn(func(_ context.Context, _ *samlsp.Config, _ *http.Request, opts ...samlsp.ResponseOption) (*samlsp.Assertion, error) {
+					gotOptions = len(opts)
+					return nil, errors.New("stop here")
+				})
+
+			resources := v2auth.NewManagementResource(config.Configuration{
+				SAML: config.SAMLConfiguration{
+					ServiceProviderCertificate: ValidCert,
+					ServiceProviderKey:         ValidKey,
+				},
+			}, mockDatabase, auth.NewAuthorizer(mockDatabase), api.NewAuthenticator(config.Configuration{}, mockDatabase, nil), nil, nil, nil)
+			resources.SAML = mockSAML
+			router := mux.NewRouter()
+			router.HandleFunc(fmt.Sprintf("/api/v2/sso/{%s}/login", api.URIPathVariableSSOProviderSlug), resources.SSOLoginHandler).Methods(http.MethodGet)
+			router.HandleFunc(fmt.Sprintf("/api/v2/sso/{%s}/callback", api.URIPathVariableSSOProviderSlug), resources.SSOCallbackHandler).Methods(http.MethodPost)
+
+			login := httptest.NewRecorder()
+			loginRequest := httptest.NewRequest(http.MethodGet, "http://bloodhound.example/api/v2/sso/slug/login", nil)
+			router.ServeHTTP(login, loginRequest.WithContext(context.WithValue(loginRequest.Context(), bhctx.ValueKey, &bhctx.Context{Host: samlTestHost()})))
+			require.Equal(t, http.StatusOK, login.Code, login.Body.String())
+			m := relayStateInput.FindStringSubmatch(login.Body.String())
+			require.NotNil(t, m, "no RelayState in the login page")
+
+			callback := httptest.NewRecorder()
+			router.ServeHTTP(callback, tc.callback(login, m[1]))
+
+			assert.Equal(t, tc.wantOptions, gotOptions)
+			assert.Equal(t, http.StatusFound, callback.Code)
+		})
+	}
+}
+
+// samlCallbackRequest returns the IdP's POST to the callback, with
+// relayState and a stand-in SAMLResponse, which the mock does not read.
+func samlCallbackRequest(relayState string) *http.Request {
+	form := url.Values{"SAMLResponse": {"response"}, "RelayState": {relayState}}
+	r := httptest.NewRequest(http.MethodPost, "http://bloodhound.example/api/v2/sso/slug/callback", strings.NewReader(form.Encode()))
+	r.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	return r.WithContext(context.WithValue(r.Context(), bhctx.ValueKey, &bhctx.Context{Host: samlTestHost()}))
+}
