+// samlConfig returns the SAML service provider for ssoProvider.
+func (s ManagementResource) samlConfig(request *http.Request, ssoProvider model.SSOProvider) (*samlsp.Config, error) {
+	var issuer string
+	if ssoProvider.SAMLProvider != nil {
+		issuer = ssoProvider.SAMLProvider.IssuerURI
+	}
+	replayState := consumedAssertions{db: s.db, ssoProviderID: ssoProvider.ID, issuer: issuer}
+	return auth.NewSAMLConfig(*bhctx.Get(request.Context()).Host, s.config, replayState, ssoProvider)
+}
+
+// consumedAssertions records verified assertions in the
+// saml_consumed_identifiers table, under their replay keys (a hash of the
+// IdP's entity ID and the assertion ID), so that each is accepted once.
+type consumedAssertions struct {
+	db            database.SAMLConsumedData
+	ssoProviderID int32
+	issuer        string
+}
+
+func (c consumedAssertions) Consume(ctx context.Context, key []byte, expiresAt time.Time) error {
+	err := c.db.ConsumeSAMLAssertionID(ctx, c.ssoProviderID, c.issuer, hex.EncodeToString(key), expiresAt)
+	switch {
+	case err == nil:
+		return nil
+	case errors.Is(err, database.ErrSAMLIdentifierAlreadyConsumed):
+		return saml.ErrAssertionReplayed
+	default:
+		return fmt.Errorf("%w: %w", ErrSAMLAssertionNotRecorded, err)
+	}
+}
+
+// ErrSAMLAssertionNotRecorded marks a failure to record a verified
+// assertion in saml_consumed_identifiers, as opposed to a SAML response
+// that does not verify. SAMLCallbackHandler reports it as a technical
+// failure.
+var ErrSAMLAssertionNotRecorded = errors.New("cannot record the SAML assertion")
+
